# Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional. Your server (guild) ID. When set, slash commands register instantly
# on that server. Leave empty to register them globally (can take up to an hour).
GUILD_ID=

# Discord sign-in. The bot reports its application ID automatically, so these
# are only needed when the Aegis server has never seen the bot run. PKCE is used,
# so no client secret is required. Register the callback in the Developer Portal:
#   https://<your-aegis-site>/api/auth/discord/callback
DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://<your-aegis-site>/api/auth/discord/callback

# Optional AI writing for /announce and /report. Any OpenAI-compatible endpoint
# works. Without a key both commands still work with a local draft generator.
# AI_BASE_URL=https://freebuff.com/api/v1/paid
# AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Self-hosted Aegis server (npm run selfhost): API, dashboard and bot in one
# process. PORT is the port the host gives you, ADMIN_TOKEN is any long random
# string (it seeds the session secret). See SELFHOST.md.
# PORT=
# ADMIN_TOKEN=
# AEGIS_ALWAYS_RUN=1
# AEGIS_HOST_TOKEN=
# AEGIS_DATA_DIR=host-data
